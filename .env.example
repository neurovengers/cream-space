# ─────────────────────────────────────────────────────────────────────────────
#  CREAM — environment template
#  Copy to `.env.local` and fill in what you have. Everything degrades
#  gracefully: any missing key automatically switches that subsystem to its
#  high-fidelity mock adapter. No key is ever required to run the prototype.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Leave blank to run on the built-in mock datastore (persisted in the browser).
# Supplying these keys switches the app to a real Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini (LLM / brief builder / offer explainer) ────────────────────
# Leave blank to run on the deterministic scripted reasoning engine.
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
NEXT_PUBLIC_GEMINI_MODEL_DEEP=gemini-2.5-pro

# ── DigiLocker (identity verification, via a consented Aadhaar/issuer flow) ──
# Leave blank to run the DIGILOCKER SANDBOX adapter.
NEXT_PUBLIC_DIGILOCKER_CLIENT_ID=
NEXT_PUBLIC_DIGILOCKER_CLIENT_SECRET=
NEXT_PUBLIC_DIGILOCKER_API_VERSION=v2.0
NEXT_PUBLIC_DIGILOCKER_ENV=sandbox

# ── Razorpay (escrow-style hold-and-release) ──────────────────────────────────
# Leave blank to run the RAZORPAY SANDBOX adapter (orders, captures, refunds).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_WEBHOOK_SECRET=

# ── SynthID / C2PA provenance stamping ───────────────────────────────────────
# Leave blank to run the LOCAL provenance stamper (C2PA manifest + watermark
# envelope + visible burn-in preview).
NEXT_PUBLIC_SYNTHID_WATERMARK_ENDPOINT=
NEXT_PUBLIC_SYNTHID_API_KEY=
NEXT_PUBLIC_C2PA_SIGNING_CERT=

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=dev-only-secret-change-in-production
DATA_MODE=auto